<Window x:Class="MAGIAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MAGIAdmin"
        Title="MAGI" Height="900" Width="1360"
        MinHeight="700" MinWidth="1000"
        Background="#DCD8F0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ══════════ CONVERTERS ══════════ -->
        <local:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- ══════════ COLORS ══════════ -->
        <SolidColorBrush x:Key="BgMain" Color="#DCD8F0"/>
        <SolidColorBrush x:Key="BgCard" Color="#F0EEFF"/>
        <SolidColorBrush x:Key="BgCardBorder" Color="#C5C5FF"/>
        <SolidColorBrush x:Key="BgAccent" Color="#B5B5D8"/>
        <SolidColorBrush x:Key="BgButton" Color="#C8C0E8"/>
        <SolidColorBrush x:Key="BgButtonHover" Color="#AEA6D6"/>
        <SolidColorBrush x:Key="BgConsole" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#E8E4F8"/>
        <SolidColorBrush x:Key="FgText" Color="#333"/>
        <SolidColorBrush x:Key="FgMuted" Color="#888"/>

        <!-- ══════════ BUTTON STYLE ══════════ -->
        <Style x:Key="MagiBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgButton}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start button (bigger, purple) -->
        <Style x:Key="StartBtn" TargetType="Button" BasedOn="{StaticResource MagiBtn}">
            <Setter Property="Background" Value="#C5C5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- Gear button (settings icon) -->
        <Style x:Key="GearBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Content" Value="⚙"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5D0EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card panel -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BgCardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- TabControl style (sidebar look) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- DataGrid style -->
        <Style x:Key="ScheduleGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0DCFF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5C5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ SIDEBAR ══════════ -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" Padding="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Logo -->
                    <TextBlock Text="MAGI" FontSize="24" FontWeight="Bold" Foreground="#555"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                </StackPanel>

                <!-- Nav buttons -->
                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#D5D0F0"/>
                                                <Setter Property="Foreground" Value="#6B5CE7"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0DCF4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Content="⚙  Микросервисы" IsSelected="True"/>
                    <ListBoxItem Content="📁  База артов"/>
                    <ListBoxItem Content="📅  Расписание"/>
                </ListBox>

                <!-- Bottom sidebar: Gateway status + Channel management -->
                <StackPanel Grid.Row="2" Margin="10,8,10,16">
                    <!-- Gateway status indicator -->
                    <Border Background="#E0DCF4" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GatewayStatusDot" Width="8" Height="8" Fill="Red"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="GatewayStatusText" Text="Gateway: Проверка..."
                                       FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Channel management button -->
                    <Button Content="📡 Каналы" Style="{StaticResource MagiBtn}"
                            Click="ChannelManagement_Click" HorizontalAlignment="Stretch"
                            Padding="8,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT AREA ══════════ -->
        <Border Grid.Column="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══════════ GLOBAL CHANNEL SELECTOR ══════════ -->
                <Border Grid.Row="0" Background="#E8E4F8" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Канал:" FontSize="13" FontWeight="SemiBold" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ChannelSelector" Width="280" Height="30" FontSize="13"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="ChannelSelector_SelectionChanged"/>
                        <Button Content="Обновить" Style="{StaticResource MagiBtn}" Margin="10,0,0,0"
                                Click="RefreshChannels_Click" Padding="10,4" FontSize="12"/>
                        <TextBlock x:Name="ChannelInfoText" Text="" FontSize="11" Foreground="#888"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═════ Pages container ═════ -->
                <Grid Grid.Row="1">

                <!-- PAGE 0: Микросервисы -->
                <Grid x:Name="PageMicroservices" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="12" Height="12" Fill="#7B6EE7" Margin="0,0,8,0"/>
                        <TextBlock Text="Микросервисы" FontSize="18" FontWeight="Bold" Foreground="#444"/>
                    </StackPanel>

                    <!-- ─── Service cards ─── -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PARSER CARD -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Парсер" FontSize="15" FontWeight="Bold" Foreground="#444"/>
                                        <Ellipse x:Name="ParserStatusDot" Width="10" Height="10" Fill="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ParserStatusText" Text="Status: Stopped" FontSize="11" Foreground="#888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GearBtn}" HorizontalAlignment="Right" Click="ParserSettings_Click"/>
                                </Grid>

                                <!-- Source selection checkboxes -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock Text="Источники:" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="CbParserPinterest" Content="Pinterest" IsChecked="True"
                                              Margin="0,0,0,4" FontSize="12" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CbParserPixiv" Content="Pixiv"
                                              Margin="0,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="2" Background="Transparent" MinHeight="20"/>

                                <Button Grid.Row="3" x:Name="BtnParserStart" Content="START" Style="{StaticResource StartBtn}" Click="ParserStart_Click"/>
                            </Grid>
                        </Border>

                        <!-- FILE TAGGER CARD -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Файл-теггер" FontSize="15" FontWeight="Bold" Foreground="#444"/>
                                        <Ellipse x:Name="TaggerStatusDot" Width="10" Height="10" Fill="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TaggerStatusText" Text="Status: Stopped" FontSize="11" Foreground="#888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GearBtn}" HorizontalAlignment="Right" Click="TaggerSettings_Click"/>
                                </Grid>

                                <Border Grid.Row="2" Background="Transparent" MinHeight="80"/>

                                <Button Grid.Row="3" x:Name="BtnTaggerStart" Content="START" Style="{StaticResource StartBtn}" Click="TaggerStart_Click"/>
                            </Grid>
                        </Border>

                        <!-- AUTOPOSTING CARD -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Автопостинг" FontSize="15" FontWeight="Bold" Foreground="#444"/>
                                        <Ellipse x:Name="AutopostStatusDot" Width="10" Height="10" Fill="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AutopostStatusText" Text="Status: Stopped" FontSize="11" Foreground="#888" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GearBtn}" HorizontalAlignment="Right" Click="AutopostSettings_Click"/>
                                </Grid>

                                <!-- Account type selector -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Аккаунт для постинга" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="RadioPersonal" Content="Линный" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RadioBot" Content="Бот" IsChecked="True" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Row="2" Background="Transparent" MinHeight="60"/>

                                <Button Grid.Row="3" x:Name="BtnAutopostStart" Content="START" Style="{StaticResource StartBtn}" Click="AutopostStart_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ─── Console Logs ─── -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Console toolbar -->
                            <Border Grid.Row="0" Background="#F5F3FF" CornerRadius="10,10,0,0" Padding="12,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox x:Name="CbAutoScroll" Content="Auto-scroll" IsChecked="True"
                                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Content="⏸ Pause" Style="{StaticResource MagiBtn}" Padding="10,4"
                                            x:Name="BtnPause" Click="ConsolePause_Click" Margin="0,0,8,0"/>
                                    <Button Content="🗑 Clear" Style="{StaticResource MagiBtn}" Padding="10,4"
                                            Click="ConsoleClear_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Log list -->
                            <Border Grid.Row="1" Background="White" CornerRadius="0,0,10,10">
                                <ListView x:Name="LogListView" Background="Transparent" BorderThickness="0"
                                          FontFamily="Consolas" FontSize="12"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="{Binding TimeFormatted}" Foreground="#888" Width="80"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding ServiceIcon}" Width="20" Margin="4,0"/>
                                                <TextBlock Text="{Binding Service}" FontWeight="SemiBold" Width="90"
                                                           Foreground="#555" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Level}" FontWeight="Bold" Width="55"
                                                           Foreground="{Binding LevelBrush}" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#333" TextWrapping="Wrap"
                                                           FontFamily="Consolas"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PAGE 1: База артов -->
                <Grid x:Name="PageArtsBase" Visibility="Collapsed">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="ImageContextMenu">
                            <MenuItem Header="Открыть" Click="CtxOpenImage_Click"/>
                            <MenuItem Header="Удалить" Click="CtxDeleteImage_Click"/>
                            <Separator/>
                            <MenuItem Header="Отметить как опубликованное" Click="CtxMarkPublished_Click"/>
                            <MenuItem Header="Копировать путь" Click="CtxCopyPath_Click"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="12" Height="12" Fill="#7B6EE7" Margin="0,0,8,0"/>
                        <TextBlock Text="База артов" FontSize="18" FontWeight="Bold" Foreground="#444"/>
                    </StackPanel>

                    <!-- Toolbar -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="↑ Путь:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TbArtsPath" Width="300" Height="28" FontSize="12"
                                         Background="White" BorderBrush="#C5C5FF" Padding="6,4"
                                         IsReadOnly="True"/>
                                <Button Content="..." Height="28" Width="35" Margin="4,0,0,0"
                                        Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                                        FontSize="14" Click="BrowseArtsPath_Click"
                                        ToolTip="Выбрать папку с артами">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="4,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#9E96C8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBox x:Name="TbSearchFile" Width="180" Height="28" FontSize="12"
                                         Background="White" BorderBrush="#C5C5FF" Padding="6,4"
                                         TextChanged="SearchFile_TextChanged"/>
                            </StackPanel>

                            <!-- Folder tabs -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Папка:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ItemsControl x:Name="FolderTabsPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Вид:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnViewGrid" Content="⊞ Сетка" Style="{StaticResource MagiBtn}"
                                        Padding="10,4" Margin="0,0,4,0" Click="ViewGrid_Click"/>
                                <Button x:Name="BtnViewList" Content="☰ Список" Style="{StaticResource MagiBtn}"
                                        Padding="10,4" Margin="0,0,16,0" Click="ViewList_Click"/>

                                <TextBlock Text="Сортировка:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbSortOrder" Width="160" Height="28" FontSize="12"
                                          SelectionChanged="SortOrder_Changed">
                                    <ComboBoxItem Content="по дате" IsSelected="True"/>
                                    <ComboBoxItem Content="по имени"/>
                                    <ComboBoxItem Content="по размеру"/>
                                </ComboBox>

                                <Button Content="⟳ Обновить" Style="{StaticResource MagiBtn}"
                                        Padding="10,4" Margin="16,0,4,0" Click="RefreshArts_Click"/>
                                <Button Content="📂 Открыть папку" Style="{StaticResource MagiBtn}"
                                        Padding="10,4" Margin="0,0,4,0" Click="OpenArtsFolder_Click"/>

                                <!-- Clean menu -->
                                <Button x:Name="BtnCleanMenu" Content="🗑 Очистить папку ▾" Style="{StaticResource MagiBtn}"
                                        Padding="10,4" Click="CleanMenu_Click"/>
                                <Popup x:Name="CleanPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnCleanMenu}"
                                       Placement="Bottom">
                                    <Border Background="White" BorderBrush="#C5C5FF" BorderThickness="1" CornerRadius="6" Padding="4">
                                        <StackPanel>
                                            <Button Content="Удалить все" Style="{StaticResource MagiBtn}" HorizontalContentAlignment="Left"
                                                    Padding="12,6" Click="CleanAll_Click"/>
                                            <Button Content="Удалить опубликованные" Style="{StaticResource MagiBtn}" HorizontalContentAlignment="Left"
                                                    Padding="12,6" Click="CleanPublished_Click"/>
                                            <Button Content="Удалить дубликаты" Style="{StaticResource MagiBtn}" HorizontalContentAlignment="Left"
                                                    Padding="12,6" Click="CleanDuplicates_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gallery (Grid view) -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
                        <Grid>
                            <!-- Grid view -->
                            <ScrollViewer x:Name="GalleryScrollGrid" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="GalleryGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6" Padding="4" CornerRadius="6" Background="#F8F6FF"
                                                    BorderBrush="#E0DCFF" BorderThickness="1" Width="160"
                                                    MouseRightButtonUp="ImageItem_RightClick" Tag="{Binding}">
                                                <StackPanel>
                                                    <Border Background="#EDE9FF" CornerRadius="4" Height="130" Margin="0,0,0,6"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding FullPath, Converter={StaticResource ImagePathConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#444" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Tags}" FontSize="10" Foreground="#888"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- List view (hidden by default) -->
                            <ListView x:Name="GalleryList" Visibility="Collapsed"
                                      Background="Transparent" BorderThickness="0"
                                      MouseRightButtonUp="ImageItem_RightClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Имя файла" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Персонаж" Width="180" DisplayMemberBinding="{Binding Tags}"/>
                                        <GridViewColumn Header="Подпись" Width="200" DisplayMemberBinding="{Binding Caption}"/>
                                        <GridViewColumn Header="Опубликован" Width="110" DisplayMemberBinding="{Binding StatusText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                        <!-- Status bar -->
                    <Border Grid.Row="3" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TbArtsTotal" Text="Всего: 0" FontSize="12" Foreground="#555" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TbArtsNew" Text="Новых: 0" FontSize="12" Foreground="#555" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TbArtsPublished" Text="Опубликовано: 0" FontSize="12" Foreground="#555" Margin="0,0,24,0"/>
                            </StackPanel>
                    </Border>
                </Grid>

                <!-- PAGE 2: Расписание -->
                <Grid x:Name="PageSchedule" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="12" Height="12" Fill="#7B6EE7" Margin="0,0,8,0"/>
                        <TextBlock Text="Расписание" FontSize="18" FontWeight="Bold" Foreground="#444"/>
                    </StackPanel>

                    <!-- Toolbar -->
                    <Border Grid.Row="1" Padding="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Добавить пост" Style="{StaticResource MagiBtn}" Padding="12,6" Margin="0,0,6,0"
                                    Click="AddScheduleSlot_Click"/>
                                <Button Content="Сохранить" Style="{StaticResource MagiBtn}" Padding="12,6" Margin="0,0,6,0"
                                    Click="SaveSchedule_Click"/>
                            </StackPanel>
                    </Border>

                    <!-- Main content: table + edit panel -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="EditPanelColumn" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <!-- Schedule table -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,0">
                            <DataGrid x:Name="ScheduleDataGrid" Style="{StaticResource ScheduleGrid}"
                                      SelectionChanged="ScheduleRow_Selected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата"        Binding="{Binding Date}"        Width="110"/>
                                    <DataGridTextColumn Header="День недели" Binding="{Binding DayOfWeek}"   Width="100"/>
                                    <DataGridTextColumn Header="Время"       Binding="{Binding Time}"        Width="80"/>
                                    <DataGridTextColumn Header="Изображение" Binding="{Binding ImageName}" Width="200"/>
                                    <DataGridTextColumn Header="Подпись" Binding="{Binding Caption}" Width="*"/>
                                    <DataGridTemplateColumn Header="Действия" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏" Style="{StaticResource MagiBtn}" Padding="6,2" Margin="0,0,4,0"
                                                            Click="EditSlot_Click" Tag="{Binding}"/>
                                                    <Button Content="🗑" Style="{StaticResource MagiBtn}" Padding="6,2"
                                                            Click="DeleteSlot_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Edit panel (right side) -->
                        <Border Grid.Column="1" x:Name="EditPanel" Style="{StaticResource CardBorder}" Margin="12,0,0,0"
                                Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="260">
                                    <TextBlock Text="Редактирование слота" FontSize="14" FontWeight="Bold"
                                               Foreground="#444" Margin="0,0,0,12"/>

                                    <TextBlock Text="Дата" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="DpSlotDate" Height="30" Margin="0,0,0,10"/>

                                    <TextBlock Text="Время" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbSlotTime" Height="30" Padding="6,4" FontSize="13"
                                             Background="White" BorderBrush="#C5C5FF" Margin="0,0,0,10"/>

                                    <TextBlock Text="Изображение" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TbSlotImage" Height="30" Padding="6,4" FontSize="12"
                                                 Background="White" BorderBrush="#C5C5FF" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="Выбрать из базы" Style="{StaticResource MagiBtn}"
                                                Padding="8,4" Margin="4,0,0,0" Click="SelectImageForSlot_Click"/>
                                    </Grid>

                                    <TextBlock Text="Подпись" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbSlotCaption" Height="60" Padding="6,4" FontSize="13"
                                             Background="White" BorderBrush="#C5C5FF" TextWrapping="Wrap"
                                             AcceptsReturn="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Теги" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbSlotTags" Height="30" Padding="6,4" FontSize="13"
                                             Background="White" BorderBrush="#C5C5FF" Margin="0,0,0,10"/>

                                    <TextBlock Text="Повтор" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbSlotRepeat" Height="30" FontSize="13" Margin="0,0,0,16">
                                        <ComboBoxItem Content="нет" IsSelected="True"/>
                                        <ComboBoxItem Content="ежедневно"/>
                                        <ComboBoxItem Content="еженедельно"/>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сохранить слот" Style="{StaticResource MagiBtn}"
                                                Padding="12,6" Margin="0,0,6,0" Click="SaveSlot_Click"/>
                                        <Button Content="Отмена" Style="{StaticResource MagiBtn}"
                                                Padding="12,6" Background="#E0D8F0" Click="CancelSlotEdit_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Posting rules panel -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Правила постинга" FontSize="14" FontWeight="Bold" Foreground="#444"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="+ Добавить время" Style="{StaticResource MagiBtn}"
                                        Padding="8,4" Click="AddPostTime_Click"/>
                            </StackPanel>

                            <!-- Rules grid: each row = one rule (time + days + caption) -->
                            <DataGrid x:Name="PostTimesGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="White"
                                      BorderBrush="#C5C5FF"
                                      BorderThickness="1"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8F8FF"
                                      FontSize="13"
                                      MaxHeight="220"
                                      SelectionMode="Single"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время"   Binding="{Binding Time}"           Width="80"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Дни"     Binding="{Binding DaysDisplay}"    Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Подпись" Binding="{Binding CaptionDisplay}" Width="*"   IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Действия" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏" Style="{StaticResource MagiBtn}"
                                                            Padding="5,2" Margin="0,0,4,0"
                                                            Tag="{Binding}"
                                                            Click="EditPostTime_Click"/>
                                                    <Button Content="🗑" Style="{StaticResource MagiBtn}"
                                                            Padding="5,2"
                                                            Tag="{Binding}"
                                                            Click="DeletePostTime_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Timezone + schedule_days -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Часовой пояс:" FontWeight="SemiBold" VerticalAlignment="Center" Width="120"/>
                                <ComboBox x:Name="CbRulesTimezone" Width="160" Height="28" FontSize="12" Margin="0,0,24,0">
                                    <ComboBoxItem Content="Europe/Moscow" IsSelected="True"/>
                                    <ComboBoxItem Content="Europe/London"/>
                                    <ComboBoxItem Content="Asia/Tokyo"/>
                                    <ComboBoxItem Content="UTC"/>
                                </ComboBox>
                                <TextBlock Text="Дней расписания:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TbScheduleDaysRules" Width="50" Height="28"
                                         Padding="6,4" FontSize="13"
                                         Background="White" BorderBrush="#C5C5FF"
                                         ToolTip="Кол-во дней при генерации расписания (schedule_days)"
                                         TextChanged="ScheduleDays_TextChanged"/>
                            </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Применить правила к расписанию" Style="{StaticResource MagiBtn}"
                                        Padding="12,6" Margin="0,0,8,0" Click="ApplyRulesToSchedule_Click"/>
                                    <Button Content="Сохранить правила" Style="{StaticResource MagiBtn}"
                                        Padding="12,6" Click="SavePostingRules_Click"/>
                                </StackPanel>
                            </StackPanel>
                    </Border>
                </Grid>
                </Grid> <!-- /Pages container -->
            </Grid>
        </Border>
    </Grid>
</Window>
