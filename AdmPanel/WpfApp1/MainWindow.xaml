<Window x:Class="MAGIAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAGI - v1.1.0" Height="820" Width="960"
        Background="#C5C5FF"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Единый стиль групп -->
        <Style x:Key="MagiGroupBox" TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E6E6FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Единый стиль кнопок -->
        <Style x:Key="MagiButton" TargetType="Button">
            <Setter Property="Background" Value="#B5B5D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Основная сетка блоков -->
            <RowDefinition Height="*"/>
            <!-- Консоль -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="MAGI"
                   HorizontalAlignment="Center"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- ===================== ОСНОВНАЯ РОВНАЯ СЕТКА ===================== -->
        <Grid Grid.Row="1">
            <!-- 3 колонки одинаковой ширины (ровная сетка) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 3 строки: верхняя, средняя, нижняя -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Чтобы расстояние между блоками было одинаковым -->
            <Grid.Margin>0</Grid.Margin>

            <!-- ROW 1 -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Настройка путей"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,10">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project root -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,6" Height="40">
                        <TextBlock x:Name="Label_ProjectRoot"
                                   Text="Корневая папка проекта"
                                   Foreground="Black"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,10,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Row="0" Grid.Column="1"
                            Content="..."
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ProjectRoot_Click"/>

                    <!-- Arts root -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,6" Height="40">
                        <TextBlock x:Name="Label_ArtsRoot"
                                   Text="Корневая папка с артами"
                                   Foreground="Black"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,10,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Row="1" Grid.Column="1"
                            Content="..."
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ArtsRoot_Click"/>

                    <!-- Channel link -->
                    <Border Grid.Row="2" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,0" Height="40">
                        <TextBox x:Name="TextBox_ChannelLink"
                                 Background="#B5B5D8"
                                 BorderThickness="0"
                                 Foreground="Black"
                                 FontWeight="Bold"
                                 VerticalContentAlignment="Center"
                                 Margin="10,0,10,0"
                                 ToolTip="Ссылка или @username Telegram-канала"/>
                    </Border>
                    <Button Grid.Row="2" Grid.Column="1"
                            Content="Save"
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ChannelLinkSave_Click"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="1" Header="Настройки"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,10" MinHeight="175">
                <StackPanel Margin="8">
                    <Button Style="{StaticResource MagiButton}" Content="user-settings.json"
                            Click="Button_Usersettings_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="posting-rules.json"
                            Click="Button_Postingrules_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="2" Header="Аккаунт для постинга"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,0,10" MinHeight="175">
                <StackPanel Margin="8">
                    <RadioButton x:Name="Radio_Personal" Content="Личный" FontWeight="Bold" Margin="0,0,0,6"/>
                    <RadioButton x:Name="Radio_Bot" Content="Бот" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

            <!-- ROW 2 -->
            <GroupBox Grid.Row="1" Grid.Column="0" Header="БД артов"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,10">
                <StackPanel Margin="8">
                    <Button Style="{StaticResource MagiButton}" Content="Check-Images"
                            Click="Button_CheckImages_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="New-Images"
                            Click="Button_NewImages_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="Post-Images"
                            Click="Button_PostImages_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="1" Header="БД .json"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,10">
                <StackPanel Margin="8">
                    <Button Style="{StaticResource MagiButton}" Content="images.json"
                            Click="Button_ImagesDb_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="posted-images.json"
                            Click="Button_PostedImagesDb_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="schedule.json"
                            Click="Button_ScheduleDb_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="2" Header="Функции clear"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,0,10">
                <StackPanel Margin="8">
                    <Button Style="{StaticResource MagiButton}" Content="images.json"
                            Click="Button_ClearImages_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="posted-images.json"
                            Click="Button_ClearPostedImages_Click"/>
                    <Button Style="{StaticResource MagiButton}" Content="schedule.json"
                            Click="Button_ClearSchedule_Click"/>
                    <Button Background="#B5B5D8" Foreground="White" FontWeight="Bold" Height="40"
                            Content="all clear"
                            Click="Button_ClearAll_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <!-- ROW 3 -->
            <GroupBox Grid.Row="2" Grid.Column="0" Header="FilenameTagger"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,0">
                <StackPanel Margin="8">
                    <Button Background="#B5B5D8" Foreground="White" FontWeight="Bold" Height="40"
                            Content="START"
                            Click="Button_FilenameTaggerStart_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="1" Header="Auto-post"
                      Style="{StaticResource MagiGroupBox}"
                      Margin="0,0,10,0">
                <StackPanel Margin="8">
                    <Button Background="#B5B5D8" Foreground="White" FontWeight="Bold" Height="40"
                            Content="START"
                            Click="Button_AutoPostStart_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <!-- Пустая ячейка (нижняя правая) для ровной сетки -->
            <Border Grid.Row="2" Grid.Column="2" Margin="0,0,0,0" />
        </Grid>

        <!-- ===================== КОНСОЛЬ С ЛОГАМИ ===================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Консоль с логами"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,4"
                       FontWeight="Bold"/>

            <Border Grid.Row="1"
                    BorderBrush="#999" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox"
                             Background="White"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Height="185"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
