<Window x:Class="MAGIAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAGI - v1.1.0" Height="820" Width="960"
        Background="#C5C5FF"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="*"/>
            <!-- основная сетка -->
            <RowDefinition Height="220"/>
            <!-- консоль -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="MAGI"
                   HorizontalAlignment="Center"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <!-- Настройка путей -->
                <GroupBox Header="Настройка путей" Margin="0,0,0,10"
          FontWeight="Bold" FontSize="14">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project root -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,6" Height="40">
                            <TextBlock x:Name="Label_ProjectRoot"
                               Text="Корневая папка проекта"
                               Foreground="Black"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,10,0"
                               TextTrimming="CharacterEllipsis"/>   
                        </Border>
                        <Button Grid.Row="0" Grid.Column="1"
                            Content="..."
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ProjectRoot_Click"/>

                        <!-- Arts root -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,6" Height="40">
                            <TextBlock x:Name="Label_ArtsRoot"
                               Text="Корневая папка с артами"
                               Foreground="Black"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,10,0"
                               TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Row="1" Grid.Column="1"
                            Content="..."
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ArtsRoot_Click"/>

                        <!-- Channel link -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#B5B5D8" Margin="0,0,8,0" Height="40">
                            <TextBox x:Name="TextBox_ChannelLink"
                                 Background="#B5B5D8"
                                 BorderThickness="0"
                                 Foreground="Black"
                                 FontWeight="Bold"
                                 VerticalContentAlignment="Center"
                                 Margin="10,0,10,0"
                                 ToolTip="Ссылка или @username Telegram-канала"/>
                        </Border>

                        <Button Grid.Row="2" Grid.Column="1"
                            Content="Save"
                            Height="40"
                            Background="#B5B5D8"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Button_ChannelLinkSave_Click"/>
                    </Grid>
                </GroupBox>


                <!-- БД артов -->
                <GroupBox Header="БД артов" Margin="0,0,0,10"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <Button Content="Check-Images"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="36" Margin="0,0,0,6"
                                Click="Button_CheckImages_Click"/>
                        <Button Content="New-Images"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="36" Margin="0,0,0,6"
                                Click="Button_NewImages_Click"/>
                        <Button Content="Post-Images"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="36"
                                Click="Button_PostImages_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- FilenameTagger -->
                <GroupBox Header="FilenameTagger" Margin="0,50,0,10"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <Button Content="START"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40"
                                Click="Button_FilenameTaggerStart_Click"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ЦЕНТРАЛЬНАЯ КОЛОНКА -->
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <!-- БД .json -->
                <GroupBox Header="БД .json" Margin="0,0,0,10"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <Button Content="images.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_ImagesDb_Click"/>
                        <Button Content="posted-images.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_PostedImagesDb_Click"/>
                        <Button Content="schedule.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40"
                                Click="Button_ScheduleDb_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Функции clear -->
                <GroupBox Header="Функции clear" Margin="0,0,0,10"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <Button Content="images.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_ClearImages_Click"/>
                        <Button Content="posted-images.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_ClearPostedImages_Click"/>
                        <Button Content="schedule.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_ClearSchedule_Click"/>
                        <Button Content="all clear"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="32"
                                Click="Button_ClearAll_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Auto-post -->
                <GroupBox Header="Auto-post"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <Button Content="START"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40"
                                Click="Button_AutoPostStart_Click"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ПРАВАЯ КОЛОНКА -->
            <StackPanel Grid.Column="2">
                <!-- Расписание -->
                <GroupBox Header="Настройки" Margin="0,0,0,10"
                          FontWeight="Bold" FontSize="14" Height="175">
                    <StackPanel Margin="8">
                        <Button Content="user-settings.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_Usersettings_Click"/>
                        <Button Content="posting-rules.json"
                                Background="#B5B5D8" Foreground="White"
                                FontWeight="Bold" Height="40" Margin="0,0,0,6"
                                Click="Button_Postingrules_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Аккаунт для постинга -->
                <GroupBox Header="Аккаунт для постинга"
                          FontWeight="Bold" FontSize="14">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                            <RadioButton x:Name="Radio_Personal"
                                         Content="Личный"
                                         FontWeight="Bold"
                                         />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Radio_Bot"
                                         Content="Бот"
                                         FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- КОНСОЛЬ С ЛОГАМИ -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Консоль с логами"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,4"
                       FontWeight="Bold"/>

            <Border Grid.Row="1"
                    BorderBrush="#999" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox"
                             Background="White"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0" Height="185"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
