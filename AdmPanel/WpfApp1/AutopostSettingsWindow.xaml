<Window x:Class="MAGIAdmin.AutopostSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки автопостинга" Height="340" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#E6E6FF"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B5B5D8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки автопостинга" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Telegram section header -->
        <TextBlock Grid.Row="1" Text="Telegram" FontSize="13" FontWeight="Bold" Foreground="#666" Margin="0,4,0,8"/>

        <!-- Channel link -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Ссылка на канал"/>
            <TextBox x:Name="TbChannelLink" Grid.Column="1" Style="{StaticResource FieldInput}"/>
        </Grid>

        <!-- API ID -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="API ID"/>
            <TextBox x:Name="TbApiId" Grid.Column="1" Style="{StaticResource FieldInput}"/>
        </Grid>

        <!-- API Hash -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="API Hash"/>
            <TextBox x:Name="TbApiHash" Grid.Column="1" Style="{StaticResource FieldInput}"/>
        </Grid>

        <!-- Session file -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Session file"/>
            <TextBox x:Name="TbSessionFile" Grid.Column="1" Style="{StaticResource FieldInput}"/>
        </Grid>

        <!-- Bot Token -->
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Bot Token"/>
            <TextBox x:Name="TbBotToken" Grid.Column="1" Style="{StaticResource FieldInput}"/>
        </Grid>

        <TextBlock Grid.Row="7" Text="(если режим «Бот»)" FontSize="11" Foreground="Gray" Margin="150,0,0,4"/>

        <TextBlock Grid.Row="8"
                   Text="JSON reference: user_settings.json — секция &quot;telegram&quot;"
                   FontSize="11" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,8,0,8"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="34" Margin="0,0,8,0"
                    Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                    Click="Save_Click"/>
            <Button Content="Закрыть" Width="100" Height="34"
                    Background="#D0D0D0" FontWeight="Bold"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
