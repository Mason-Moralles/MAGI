<Window x:Class="MAGIAdmin.ParserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки парсера" Height="680" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#E6E6FF"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B5B5D8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: title -->
            <RowDefinition Height="Auto"/>  <!-- 1: section "Пути" -->
            <RowDefinition Height="Auto"/>  <!-- 2: config path -->
            <RowDefinition Height="Auto"/>  <!-- 3: DB path -->
            <RowDefinition Height="Auto"/>  <!-- 4: extensions -->
            <RowDefinition Height="Auto"/>  <!-- 5: section "Параметры" -->
            <RowDefinition Height="Auto"/>  <!-- 6: download path -->
            <RowDefinition Height="Auto"/>  <!-- 7: scroll + delay + images per hashtag -->
            <RowDefinition Height="Auto"/>  <!-- 8: section "Хэштеги" -->
            <RowDefinition Height="Auto"/>  <!-- 9: hashtags textbox -->
            <RowDefinition Height="Auto"/>  <!-- 10: section "Негативные хэштеги" -->
            <RowDefinition Height="Auto"/>  <!-- 11: negative hashtags textbox -->
            <RowDefinition Height="Auto"/>  <!-- 12: json path label -->
            <RowDefinition Height="*"/>     <!-- 13: spacer -->
            <RowDefinition Height="Auto"/>  <!-- 14: buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки парсера" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Пути (read-only info) -->
        <TextBlock Grid.Row="1" Style="{StaticResource SectionHeader}" Text="Пути"/>

        <!-- Config path -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Путь к конфигу"/>
            <TextBox x:Name="TbConfigPath" Grid.Column="1" Style="{StaticResource FieldInput}"
                     IsReadOnly="True" Foreground="#888"/>
        </Grid>

        <!-- DB path -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Путь к БД"/>
            <TextBox x:Name="TbDbPath" Grid.Column="1" Style="{StaticResource FieldInput}"
                     IsReadOnly="True" Foreground="#888"/>
        </Grid>

        <!-- Extensions -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Фильтр расширений"/>
            <TextBox x:Name="TbExtensions" Grid.Column="1" Style="{StaticResource FieldInput}"
                     IsReadOnly="True" Foreground="#888" Text=".jpg .png .webp"/>
        </Grid>

        <!-- Параметры парсинга -->
        <TextBlock Grid.Row="5" Style="{StaticResource SectionHeader}" Text="Параметры парсинга"/>

        <!-- Download path -->
        <Grid Grid.Row="6" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="35"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Папка загрузки"/>
            <TextBox x:Name="TbDownloadPath" Grid.Column="1" Style="{StaticResource FieldInput}"/>
            <Button Grid.Column="2" Content="..." Height="28" Margin="4,0,0,0"
                    Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                    Click="BrowseDownloadPath_Click"/>
        </Grid>

        <!-- Scroll delay + image delay + images per hashtag (all on one row) -->
        <Grid Grid.Row="7" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Скролл, мс"/>
            <TextBox x:Name="TbScrollDelay" Grid.Column="1" Style="{StaticResource FieldInput}"/>

            <TextBlock Grid.Column="3" Text="Задержка, мс" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TbImageDelay" Grid.Column="4" Style="{StaticResource FieldInput}"/>

            <TextBlock Grid.Column="6" Text="Изобр./хэштег" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TbImagesPerHashtag" Grid.Column="7" Style="{StaticResource FieldInput}"/>
        </Grid>

        <!-- Хэштеги для поиска -->
        <TextBlock Grid.Row="8" Style="{StaticResource SectionHeader}" Text="Хэштеги для поиска (по одному на строку)"/>

        <TextBox Grid.Row="9" x:Name="TbHashtags"
                 Height="110" Padding="6,4" FontSize="13"
                 Background="White" BorderBrush="#B5B5D8" BorderThickness="1"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>

        <!-- Негативные хэштеги для Pixiv -->
        <TextBlock Grid.Row="10" Style="{StaticResource SectionHeader}" Text="Негативные хэштеги для Pixiv (по одному на строку)"/>

        <TextBox Grid.Row="11" x:Name="TbNegativeHashtags"
                 Height="65" Padding="6,4" FontSize="13"
                 Background="White" BorderBrush="#B5B5D8" BorderThickness="1"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>

        <TextBlock Grid.Row="12"
                   Text="JSON: data/json/parser/config.json"
                   FontSize="11" Foreground="Gray" Margin="0,6,0,0"/>

        <!-- Spacer -->
        <Border Grid.Row="13"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Width="100" Height="34" Margin="0,0,8,0"
                    Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                    Click="Save_Click"/>
            <Button Content="Закрыть" Width="100" Height="34"
                    Background="#D0D0D0" FontWeight="Bold"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
