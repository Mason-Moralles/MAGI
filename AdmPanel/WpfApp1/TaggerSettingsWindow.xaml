<Window x:Class="MAGIAdmin.TaggerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки файл-теггера" Height="560" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#E6E6FF"
        ResizeMode="CanResize"
    MinHeight="400" MinWidth="500"
    AutomationProperties.AutomationId="TaggerSettings_Root">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B5B5D8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки файл-теггера" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Rename template -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Шаблон переименования"/>
            <TextBox x:Name="TbRenameTemplate" AutomationProperties.AutomationId="TaggerSettings_RenameTemplate" Grid.Column="1" Style="{StaticResource FieldInput}"
                     Text="{}{artist}_{title}_{id}"/>
        </Grid>

        <!-- Tag separator -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Разделитель тегов"/>
            <TextBox x:Name="TbSeparator" AutomationProperties.AutomationId="TaggerSettings_Separator" Grid.Column="1" Style="{StaticResource FieldInput}"
                     Text="_"/>
        </Grid>

        <!-- Process only new -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Обрабатывать только новые"/>
            <CheckBox x:Name="CbOnlyNew" AutomationProperties.AutomationId="TaggerSettings_OnlyNew" Grid.Column="1" VerticalAlignment="Center"
                      IsChecked="True"/>
        </Grid>

        <!-- Mode -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Режим"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="RbRename" AutomationProperties.AutomationId="TaggerSettings_ModeRename" Content="Переименовать" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbCopy" AutomationProperties.AutomationId="TaggerSettings_ModeCopy" Content="Копировать" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Filename Tags header -->
        <Grid Grid.Row="5" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Теги по ключевым словам" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnAddTag" Content="+ Добавить" Width="90" Height="28"
                        Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                        Click="AddTag_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnRemoveTag" Content="- Удалить" Width="90" Height="28"
                        Background="#D0D0D0" FontWeight="Bold"
                        Click="RemoveTag_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filename Tags DataGrid -->
        <DataGrid x:Name="DgTags" AutomationProperties.AutomationId="TaggerSettings_TagsGrid" Grid.Row="6" Margin="0,0,0,12"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#B5B5D8" BorderThickness="1"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F5F5FF"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ключевое слово" Binding="{Binding Keyword}" Width="*" />
                <DataGridTextColumn Header="Тег (хэштег)" Binding="{Binding Tag}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSaveTaggerSettings" AutomationProperties.AutomationId="TaggerSettings_Save" Content="Сохранить" Width="100" Height="34" Margin="0,0,8,0"
                    Background="#B5B5D8" Foreground="White" FontWeight="Bold"
                    Click="Save_Click"/>
            <Button AutomationProperties.AutomationId="TaggerSettings_Close" Content="Закрыть" Width="100" Height="34"
                    Background="#D0D0D0" FontWeight="Bold"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
