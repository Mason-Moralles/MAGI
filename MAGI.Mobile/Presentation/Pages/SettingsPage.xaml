<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MAGI.Mobile.Core.Presentation.ViewModels;assembly=MAGI.Mobile.Core"
             x:Class="MAGI.Mobile.Presentation.Pages.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
                  Title="Настройки">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
                 <Label Text="Настройки"
                   FontSize="24"
                   FontAttributes="Bold" />

                 <Label Text="Адрес Gateway"
                   FontAttributes="Bold" />
            <Entry Text="{Binding GatewayBaseUrl}"
                   Keyboard="Url" />

            <HorizontalStackLayout Spacing="12">
                  <Button Text="Сохранить" Command="{Binding SaveCommand}" />
                  <Button Text="Проверить подключение" Command="{Binding TestConnectionCommand}" />
            </HorizontalStackLayout>

            <Label Text="{Binding StatusMessage}" />
            <Label TextColor="Red" Text="{Binding ErrorMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>