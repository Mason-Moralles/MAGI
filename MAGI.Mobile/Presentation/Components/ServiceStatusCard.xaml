<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domain="clr-namespace:MAGI.Mobile.Core.Domain.Entities;assembly=MAGI.Mobile.Core"
             x:Class="MAGI.Mobile.Presentation.Components.ServiceStatusCard"
             x:DataType="domain:ServiceStatus">
    <Border Padding="12" Margin="0,0,0,8">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
            <Label Text="{Binding DisplayStatus}" />
            <Label Text="{Binding BaseUrl}" FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
    </Border>
</ContentView>