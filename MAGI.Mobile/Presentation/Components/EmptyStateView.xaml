<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MAGI.Mobile.Presentation.Components"
             x:Class="MAGI.Mobile.Presentation.Components.EmptyStateView"
             x:Name="This"
             x:DataType="components:EmptyStateView">
    <Border Padding="16" BackgroundColor="{StaticResource Secondary}">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Source={x:Reference This}, Path=Title}"
                   FontAttributes="Bold"
                   FontSize="18" />
            <Label Text="{Binding Source={x:Reference This}, Path=Message}"
                   Opacity="0.8" />
        </VerticalStackLayout>
    </Border>
</ContentView>