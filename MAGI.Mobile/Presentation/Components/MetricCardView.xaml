<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MAGI.Mobile.Presentation.Components"
             x:Class="MAGI.Mobile.Presentation.Components.MetricCardView"
             x:Name="This"
             x:DataType="components:MetricCardView">
    <Border Padding="12" StrokeThickness="1">
        <VerticalStackLayout>
            <Label Text="{Binding Source={x:Reference This}, Path=Title}"
                   FontAttributes="Bold" />
            <Label Text="{Binding Source={x:Reference This}, Path=Value}"
                   FontSize="20" />
        </VerticalStackLayout>
    </Border>
</ContentView>